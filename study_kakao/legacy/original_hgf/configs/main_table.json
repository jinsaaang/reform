{
  "schema": "hgf_main_table",
  "model": "google/gemini-2.5-flash-lite",
  "workers": 4,
  "question_count": 100,
  "hgf_contract": {
    "memory_selection": "fixed_retrieved_memory_question_id",
    "worked_exemplar": "fixed_worked_exemplar",
    "semantic_lessons": "frozen_43_entry_cache",
    "reasoning_and_boundary": "canonical"
  },
  "methods": [
    "search_only",
    "factor_memory",
    "case_memory",
    "text_memory",
    "direct_dag",
    "prospective_dag",
    "hgf"
  ],
  "metrics": ["accuracy", "brier", "nll"],
  "reporting": "mean_plus_minus_std_across_repeated_runs"
}
