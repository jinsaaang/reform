{
  "schema": "hgf_v27_paper_experiments_v1",
  "workers": 4,
  "models": [
    "google/gemini-2.5-flash-lite",
    "openai/gpt-5-mini",
    "deepseek/deepseek-v3.2"
  ],
  "repeats": 3,
  "main_table_methods": [
    "search_only",
    "factor_memory",
    "case_memory",
    "text_memory",
    "direct_dag",
    "prospective_dag",
    "hgf"
  ],
  "ablation_model": "google/gemini-2.5-flash-lite",
  "ablation_conditions": [
    "raw_dag",
    "full_hgf",
    "without_counterevidence",
    "without_target_bridge",
    "without_uncertainty"
  ],
  "topk_values": [1, 3, 5, 7],
  "judge": {
    "model": "google/gemini-3.1-flash-lite",
    "passes": 1,
    "blind_fields": ["method", "model", "ground_truth"],
    "measures": [
      "evidence_coverage",
      "invalid_reasoning",
      "invalid_among_correct"
    ],
    "aggregation": {
      "evidence_coverage": "supported_required_evidence_items/all_required_evidence_items",
      "invalid_reasoning": "invalid_forecasts/all_forecasts",
      "invalid_among_correct": "invalid_correct_forecasts/all_correct_forecasts"
    }
  },
  "bootstrap_iterations": 10000,
  "bootstrap_seed": 27
}
